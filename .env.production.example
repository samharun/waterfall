APP_NAME=Waterfall
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bdwaterfall.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waterfall
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=bdwaterfall.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FIREBASE_PROJECT_ID=waterfall-d478d
# This must be a Firebase service-account JSON file stored outside public/.
FIREBASE_CREDENTIALS=app/firebase/firebase-service-account.json

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bdwaterfall.com
MAIL_FROM_NAME="${APP_NAME}"

SMS_DRIVER=ssl_wireless
SSL_WIRELESS_URL=https://sms.sslwireless.com/pushapi/dynamic/server.php
SSL_WIRELESS_API_TOKEN=
SSL_WIRELESS_SID=
